<Project>

  <!-- Settings every project in the solution shares. Per-project values (OutputType, packages) stay in the .csproj. -->
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <Nullable>enable</Nullable>
    <ImplicitUsings>enable</ImplicitUsings>
    <LangVersion>latest</LangVersion>
    <Version>0.1.0</Version>
    <Product>AMPLE</Product>
    <Authors>ClearanceClarence</Authors>
    <Company>ClearanceClarence</Company>
    <Copyright>Copyright (c) 2026 ClearanceClarence</Copyright>

    <!-- Code rules: see .editorconfig. IDE rules set to warning there also show up in dotnet build. -->
    <AnalysisLevel>latest-recommended</AnalysisLevel>
    <EnforceCodeStyleInBuild>true</EnforceCodeStyleInBuild>
  </PropertyGroup>

</Project>
