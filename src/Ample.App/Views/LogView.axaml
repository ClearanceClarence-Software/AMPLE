<UserControl xmlns="https://github.com/avaloniaui"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:vm="using:Ample.App.ViewModels"
             x:Class="Ample.App.Views.LogView"
             x:DataType="vm:LogViewModel">

    <StackPanel Spacing="20">
        <Grid ColumnDefinitions="*,Auto">
            <StackPanel Spacing="4">
                <TextBlock Classes="h1" Text="Logs" />
                <TextBlock Classes="muted" Text="What AMPLE did, and why something didn't work." />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" Spacing="8" VerticalAlignment="Bottom">
                <Button Content="{Binding DebugLabel}" Command="{Binding ToggleDebugCommand}" />
                <Button Content="Copy" Click="Copy_Click" />
                <Button Content="Clear" Command="{Binding ClearCommand}" />
            </StackPanel>
        </Grid>

        <Border Classes="card" Padding="0">
            <ScrollViewer x:Name="LogScroll" MaxHeight="560" Padding="16,12">
                <ItemsControl ItemsSource="{Binding Entries}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:LogEntry">
                            <Grid ColumnDefinitions="70,84,*" Margin="0,2">
                                <TextBlock Classes="mono muted" Text="{Binding TimeText}" />
                                <TextBlock Grid.Column="1" Classes="mono accent" Text="{Binding SourceText}" />
                                <SelectableTextBlock Grid.Column="2" FontFamily="Cascadia Mono, Consolas, Courier New, monospace" FontSize="13"
                                                     Text="{Binding Message}" TextWrapping="Wrap"
                                                     Foreground="{Binding BrushKey, Converter={x:Static vm:BrushKeyConverter.Instance}}" />
                            </Grid>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Border>

        <Border Classes="card">
            <StackPanel Spacing="12">
                <Grid ColumnDefinitions="*,Auto">
                    <StackPanel Spacing="3">
                        <TextBlock Classes="h3" Text="Server logs" />
                        <TextBlock Classes="muted" Text="Apache, PHP and MariaDB write their own logs under logs\." />
                    </StackPanel>
                    <Button Grid.Column="1" Content="Open logs folder" Command="{Binding OpenLogsFolderCommand}" />
                </Grid>
                <ItemsControl ItemsSource="{Binding ServerLogs}">
                    <ItemsControl.ItemsPanel>
                        <ItemsPanelTemplate>
                            <WrapPanel />
                        </ItemsPanelTemplate>
                    </ItemsControl.ItemsPanel>
                    <ItemsControl.ItemTemplate>
                        <DataTemplate x:DataType="vm:FileLink">
                            <Button Classes="ghost" Margin="0,0,8,8" Content="{Binding Label}" Command="{Binding OpenCommand}" />
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </StackPanel>
        </Border>
    </StackPanel>
</UserControl>
