<Styles xmlns="https://github.com/avaloniaui"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

    <Styles.Resources>
        <ResourceDictionary>
            <!-- Colors per theme. Everything takes DynamicResource, so switching the theme repaints at once.
                 The dark palette is the design's: graphite grounds, CC Software blues, green/amber/gray status. -->
            <ResourceDictionary.ThemeDictionaries>
                <ResourceDictionary x:Key="Dark">
                    <SolidColorBrush x:Key="PageBrush" Color="#0F1115" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#13161C" />
                    <SolidColorBrush x:Key="CardBrush" Color="#181B22" />
                    <SolidColorBrush x:Key="CardAltBrush" Color="#1F232C" />
                    <SolidColorBrush x:Key="LineBrush" Color="#232733" />
                    <SolidColorBrush x:Key="LineStrongBrush" Color="#2F3542" />
                    <SolidColorBrush x:Key="TextBrush" Color="#E7E9EE" />
                    <SolidColorBrush x:Key="TextSoftBrush" Color="#C3C9D4" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#9AA3B2" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#93C5FD" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#1B2433" />
                    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#2B3A55" />
                    <SolidColorBrush x:Key="NavActiveBrush" Color="#1F2633" />
                    <SolidColorBrush x:Key="OkBrush" Color="#4ADE80" />
                    <SolidColorBrush x:Key="OkTextBrush" Color="#86EFAC" />
                    <SolidColorBrush x:Key="OkSoftBrush" Color="#163A26" />
                    <SolidColorBrush x:Key="WarnBrush" Color="#FBBF24" />
                    <SolidColorBrush x:Key="WarnTextBrush" Color="#FCD34D" />
                    <SolidColorBrush x:Key="WarnSoftBrush" Color="#2A2213" />
                    <SolidColorBrush x:Key="WarnSoftBorderBrush" Color="#4A3A17" />
                    <SolidColorBrush x:Key="WarnOnBrush" Color="#1A1406" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#F87171" />
                    <SolidColorBrush x:Key="StoppedBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="StoppedTextBrush" Color="#A3ABB9" />
                    <SolidColorBrush x:Key="StoppedSoftBrush" Color="#232733" />
                    <SolidColorBrush x:Key="DebugBrush" Color="#8B93A0" />
                    <SolidColorBrush x:Key="InputBrush" Color="#0F1115" />
                </ResourceDictionary>
                <ResourceDictionary x:Key="Light">
                    <SolidColorBrush x:Key="PageBrush" Color="#F4F5F7" />
                    <SolidColorBrush x:Key="SidebarBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardBrush" Color="#FFFFFF" />
                    <SolidColorBrush x:Key="CardAltBrush" Color="#F1F3F6" />
                    <SolidColorBrush x:Key="LineBrush" Color="#E0E3E8" />
                    <SolidColorBrush x:Key="LineStrongBrush" Color="#C8CDD5" />
                    <SolidColorBrush x:Key="TextBrush" Color="#141821" />
                    <SolidColorBrush x:Key="TextSoftBrush" Color="#3B4048" />
                    <SolidColorBrush x:Key="MutedBrush" Color="#5B6472" />
                    <SolidColorBrush x:Key="AccentBrush" Color="#2563EB" />
                    <SolidColorBrush x:Key="AccentHoverBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentTextBrush" Color="#1D4ED8" />
                    <SolidColorBrush x:Key="AccentSoftBrush" Color="#EAF1FE" />
                    <SolidColorBrush x:Key="AccentSoftBorderBrush" Color="#BFD6FB" />
                    <SolidColorBrush x:Key="NavActiveBrush" Color="#EAF1FE" />
                    <SolidColorBrush x:Key="OkBrush" Color="#16A34A" />
                    <SolidColorBrush x:Key="OkTextBrush" Color="#15803D" />
                    <SolidColorBrush x:Key="OkSoftBrush" Color="#E3F6EA" />
                    <SolidColorBrush x:Key="WarnBrush" Color="#D97706" />
                    <SolidColorBrush x:Key="WarnTextBrush" Color="#A15C07" />
                    <SolidColorBrush x:Key="WarnSoftBrush" Color="#FFF4DD" />
                    <SolidColorBrush x:Key="WarnSoftBorderBrush" Color="#F3D28A" />
                    <SolidColorBrush x:Key="WarnOnBrush" Color="#1A1406" />
                    <SolidColorBrush x:Key="ErrorBrush" Color="#B42318" />
                    <SolidColorBrush x:Key="StoppedBrush" Color="#9AA1AB" />
                    <SolidColorBrush x:Key="StoppedTextBrush" Color="#5D6470" />
                    <SolidColorBrush x:Key="StoppedSoftBrush" Color="#ECEEF2" />
                    <SolidColorBrush x:Key="DebugBrush" Color="#6B7280" />
                    <SolidColorBrush x:Key="InputBrush" Color="#FFFFFF" />
                </ResourceDictionary>
            </ResourceDictionary.ThemeDictionaries>

            <!-- Icons: 24×24 stroke paths, drawn with the current foreground. -->
            <StreamGeometry x:Key="IconOverview">M3,3 L10,3 L10,12 L3,12 Z M14,3 L21,3 L21,8 L14,8 Z M14,12 L21,12 L21,21 L14,21 Z M3,16 L10,16 L10,21 L3,21 Z</StreamGeometry>
            <StreamGeometry x:Key="IconProjects">M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z</StreamGeometry>
            <StreamGeometry x:Key="IconVersions">M12,3 L21,7.5 L12,12 L3,7.5 Z M3,12 L12,16.5 L21,12 M3,16.5 L12,21 L21,16.5</StreamGeometry>
            <StreamGeometry x:Key="IconLogs">M4,6 L20,6 M4,12 L20,12 M4,18 L14,18</StreamGeometry>
            <StreamGeometry x:Key="IconSettings">M12,9 A3,3 0 1 0 12,15 A3,3 0 1 0 12,9 Z M12,2 L12,5 M12,19 L12,22 M4.2,4.2 L6.3,6.3 M17.7,17.7 L19.8,19.8 M2,12 L5,12 M19,12 L22,12 M4.2,19.8 L6.3,17.7 M17.7,6.3 L19.8,4.2</StreamGeometry>
            <StreamGeometry x:Key="IconExternal">M7,17 L17,7 M8,7 L17,7 L17,16</StreamGeometry>
            <StreamGeometry x:Key="IconMoon">M21,12.8 A9,9 0 1 1 11.2,3 A7,7 0 0 0 21,12.8 Z</StreamGeometry>
            <StreamGeometry x:Key="IconSun">M12,8 A4,4 0 1 0 12,16 A4,4 0 1 0 12,8 Z M12,2 L12,4 M12,20 L12,22 M4.9,4.9 L6.3,6.3 M17.7,17.7 L19.1,19.1 M2,12 L4,12 M20,12 L22,12 M4.9,19.1 L6.3,17.7 M17.7,6.3 L19.1,4.9</StreamGeometry>
            <StreamGeometry x:Key="IconFolder">M3,7 A2,2 0 0 1 5,5 L9,5 L11,7 L19,7 A2,2 0 0 1 21,9 L21,17 A2,2 0 0 1 19,19 L5,19 A2,2 0 0 1 3,17 Z</StreamGeometry>
            <StreamGeometry x:Key="IconTrash">M4,7 L20,7 M9,7 L9,4 L15,4 L15,7 M6,7 L7,20 L17,20 L18,7</StreamGeometry>
        </ResourceDictionary>
    </Styles.Resources>

    <!-- ── Page basics ─────────────────────────────────────────────────── -->
    <Style Selector="Window">
        <Setter Property="Background" Value="{DynamicResource PageBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontSize" Value="14" />
    </Style>
    <Style Selector="TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.h1">
        <Setter Property="FontSize" Value="28" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h2">
        <Setter Property="FontSize" Value="22" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.h3">
        <Setter Property="FontSize" Value="16" />
        <Setter Property="FontWeight" Value="Bold" />
    </Style>
    <Style Selector="TextBlock.muted">
        <Setter Property="Foreground" Value="{DynamicResource MutedBrush}" />
    </Style>
    <Style Selector="TextBlock.soft">
        <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}" />
    </Style>
    <Style Selector="TextBlock.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
        <Setter Property="FontSize" Value="13" />
    </Style>
    <Style Selector="TextBlock.accent">
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- ── Cards ───────────────────────────────────────────────────────── -->
    <Style Selector="Border.card">
        <Setter Property="Background" Value="{DynamicResource CardBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="16" />
        <Setter Property="Padding" Value="20" />
    </Style>
    <Style Selector="Border.hero">
        <Setter Property="Padding" Value="28" />
        <Setter Property="CornerRadius" Value="18" />
    </Style>
    <Style Selector="Border.notice">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
    </Style>
    <Style Selector="Border.info">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentSoftBorderBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="14,12" />
    </Style>

    <!-- ── Status pill: a dot and a label ──────────────────────────────── -->
    <Style Selector="Border.pill">
        <Setter Property="CornerRadius" Value="999" />
        <Setter Property="Padding" Value="10,4" />
        <Setter Property="Background" Value="{DynamicResource StoppedSoftBrush}" />
    </Style>
    <Style Selector="Border.pill TextBlock">
        <Setter Property="FontSize" Value="12" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Foreground" Value="{DynamicResource StoppedTextBrush}" />
    </Style>
    <Style Selector="Border.pill Ellipse">
        <Setter Property="Width" Value="7" />
        <Setter Property="Height" Value="7" />
        <Setter Property="Fill" Value="{DynamicResource StoppedBrush}" />
    </Style>
    <Style Selector="Border.pill.running">
        <Setter Property="Background" Value="{DynamicResource OkSoftBrush}" />
    </Style>
    <Style Selector="Border.pill.running TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource OkTextBrush}" />
    </Style>
    <Style Selector="Border.pill.running Ellipse">
        <Setter Property="Fill" Value="{DynamicResource OkBrush}" />
    </Style>
    <Style Selector="Border.pill.attention">
        <Setter Property="Background" Value="{DynamicResource WarnSoftBrush}" />
    </Style>
    <Style Selector="Border.pill.attention TextBlock">
        <Setter Property="Foreground" Value="{DynamicResource WarnTextBrush}" />
    </Style>
    <Style Selector="Border.pill.attention Ellipse">
        <Setter Property="Fill" Value="{DynamicResource WarnBrush}" />
    </Style>

    <!-- ── Buttons ─────────────────────────────────────────────────────── -->
    <Style Selector="Button">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Padding" Value="16,0" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="VerticalContentAlignment" Value="Center" />
        <Setter Property="HorizontalContentAlignment" Value="Center" />
    </Style>
    <Style Selector="Button:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.primary">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.primary:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentHoverBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Button.big">
        <Setter Property="MinHeight" Value="50" />
        <Setter Property="MinWidth" Value="150" />
        <Setter Property="Padding" Value="26,0" />
        <Setter Property="FontSize" Value="15" />
        <Setter Property="CornerRadius" Value="12" />
    </Style>
    <Style Selector="Button.warn">
        <Setter Property="Background" Value="{DynamicResource WarnBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource WarnBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource WarnOnBrush}" />
    </Style>
    <Style Selector="Button.ghost">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.ghost:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource AccentTextBrush}" />
    </Style>
    <Style Selector="Button.icon">
        <Setter Property="Padding" Value="0" />
        <Setter Property="Width" Value="40" />
        <Setter Property="Height" Value="40" />
    </Style>

    <!-- Segmented switch, e.g. Ledger | phpMyAdmin -->
    <Style Selector="Border.segment">
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineBrush}" />
        <Setter Property="BorderThickness" Value="1" />
        <Setter Property="CornerRadius" Value="12" />
        <Setter Property="Padding" Value="4" />
    </Style>
    <Style Selector="Border.segment Button">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="CornerRadius" Value="9" />
        <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}" />
    </Style>
    <Style Selector="Border.segment Button.selected">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>
    <Style Selector="Border.segment Button.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Foreground" Value="White" />
    </Style>

    <!-- Option cards, e.g. the two database tools in Settings -->
    <Style Selector="Button.tool">
        <Setter Property="Background" Value="{DynamicResource SidebarBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="BorderThickness" Value="2" />
        <Setter Property="CornerRadius" Value="14" />
        <Setter Property="VerticalContentAlignment" Value="Top" />
    </Style>
    <Style Selector="Button.tool:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource CardAltBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
    </Style>
    <Style Selector="Button.tool.selected">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>
    <Style Selector="Button.tool.selected:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource AccentSoftBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource AccentBrush}" />
    </Style>

    <!-- Sidebar navigation -->
    <Style Selector="Button.nav">
        <Setter Property="Background" Value="Transparent" />
        <Setter Property="BorderThickness" Value="0" />
        <Setter Property="HorizontalAlignment" Value="Stretch" />
        <Setter Property="HorizontalContentAlignment" Value="Left" />
        <Setter Property="Padding" Value="12,0" />
        <Setter Property="MinHeight" Value="42" />
        <Setter Property="FontWeight" Value="Normal" />
        <Setter Property="Foreground" Value="{DynamicResource TextSoftBrush}" />
    </Style>
    <Style Selector="Button.nav:pointerover /template/ ContentPresenter#PART_ContentPresenter">
        <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="Button.nav.active">
        <Setter Property="Background" Value="{DynamicResource NavActiveBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="FontWeight" Value="SemiBold" />
    </Style>
    <Style Selector="Button.nav:disabled">
        <Setter Property="Opacity" Value="0.4" />
    </Style>
    <Style Selector="Button.nav Path">
        <Setter Property="Stroke" Value="{DynamicResource TextSoftBrush}" />
    </Style>
    <Style Selector="Button.nav.active Path">
        <Setter Property="Stroke" Value="{DynamicResource AccentTextBrush}" />
    </Style>

    <!-- Stroke icons -->
    <Style Selector="Path.icon">
        <Setter Property="Width" Value="18" />
        <Setter Property="Height" Value="18" />
        <Setter Property="Stretch" Value="Uniform" />
        <Setter Property="Fill" Value="Transparent" />
        <Setter Property="Stroke" Value="{DynamicResource TextSoftBrush}" />
        <Setter Property="StrokeThickness" Value="2" />
        <Setter Property="StrokeLineCap" Value="Round" />
        <Setter Property="StrokeJoin" Value="Round" />
    </Style>

    <!-- ── Inputs ──────────────────────────────────────────────────────── -->
    <Style Selector="TextBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="12,8" />
    </Style>
    <Style Selector="TextBox.mono">
        <Setter Property="FontFamily" Value="Cascadia Mono, Consolas, Courier New, monospace" />
    </Style>
    <Style Selector="ComboBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="CornerRadius" Value="10" />
        <Setter Property="Background" Value="{DynamicResource InputBrush}" />
        <Setter Property="BorderBrush" Value="{DynamicResource LineStrongBrush}" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
        <Setter Property="Padding" Value="12,0" />
    </Style>
    <Style Selector="CheckBox">
        <Setter Property="MinHeight" Value="40" />
        <Setter Property="Foreground" Value="{DynamicResource TextBrush}" />
    </Style>
    <Style Selector="TextBlock.label">
        <Setter Property="FontWeight" Value="SemiBold" />
        <Setter Property="Margin" Value="0,0,0,6" />
    </Style>
    <Style Selector="ProgressBar">
        <Setter Property="Foreground" Value="{DynamicResource AccentBrush}" />
        <Setter Property="Background" Value="{DynamicResource LineBrush}" />
        <Setter Property="CornerRadius" Value="4" />
        <Setter Property="MinHeight" Value="8" />
    </Style>
</Styles>
